# Скопируйте этот файл в .env и подставьте свои значения.
# Файл .env никуда не коммитится (см. .gitignore).

# Строка подключения к PostgreSQL (SQLAlchemy + psycopg 3):
# postgresql+psycopg://<пользователь>:<пароль>@<хост>:<порт>/<имя_базы>
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/cook_assistant

# Название приложения (показывается в /api/health)
APP_NAME=Ассистент повара

# Хост и порт для запуска сервера
HOST=127.0.0.1
PORT=8000

# Разрешённые источники (origins) фронтенда для CORS — JSON-список
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]